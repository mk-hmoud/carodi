.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# Local state and secrets
data/*.db
data/*.db-journal
.env

# Sponsor registers are large and republished every few weeks. One dated
# snapshot of each is committed so the repo works out of the box; any other
# CSV you drop here (a fresher download under its original filename) stays
# local. Refreshing a snapshot in place shows up as an ordinary diff.
data/registers/*.csv
data/registers/*.xlsx
!data/registers/uk_licensed_sponsors.csv
!data/registers/nl_recognised_sponsors.csv
